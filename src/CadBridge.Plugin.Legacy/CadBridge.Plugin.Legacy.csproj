<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CadBridge Legacy plugin shell.

    Target framework choice is EVIDENCE-BASED, not conventional:
      * AutoCAD 2015-2024 hosts run on .NET Framework. Verified on this machine by
        (a) the presence of acad.exe.config with assemblyBinding/bindingRedirect, and
        (b) the ABSENCE of acdbmgd.runtimeconfig.json in those install directories.
      * AutoCAD 2025-2026 ship acdbmgd.runtimeconfig.json declaring tfm "net8.0".

    Autodesk managed assemblies are HINT-PATH compile-time references only.
    They are NEVER copied into output (Private=false), because the Autodesk ObjectARX
    EULA grants development use only and the release package must bind to the
    installed AutoCAD. See docs/evidence/P0/*/raw/source-register-summary.md.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CadBridge.Plugin.Legacy</AssemblyName>
    <RootNamespace>CadBridge.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <Product>CadBridge Plugin (Legacy)</Product>
    <Company>CadBridge</Company>

    <!-- Opt in to AutoCAD references. Directory.Build.props only acts when this is true. -->
    <CadBridgePlugin>true</CadBridgePlugin>
    <!-- Conservative floor: oldest Autodesk managed reference set available locally (19.1).
         NOT proof of AutoCAD 2015 compatibility; see docs/design/dependency-lock.md. -->
    <CadBridgeRefSet>core</CadBridgeRefSet>

  </PropertyGroup>

  <!-- One shared source tree, compiled into both shells. No per-year business code. -->
  <ItemGroup>
    <Compile Include="..\Plugin.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
