<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-independent regression tests for RadiusPromptPolicy.

    WHAT THIS COVERS (be precise about it)
      * The DECISION LOGIC that maps a PromptStatus to create / create-with-default / refuse.
      * The real Autodesk.AutoCAD.EditorInput.PromptStatus enum values, so the policy cannot
        silently drift from the SDK.

    WHAT THIS DOES NOT COVER
      * No AutoCAD is started. No document, no editor, no prompt, no geometry is created.
      * It therefore does NOT prove live cancellation behaviour end to end. That requires a
        real host and is tracked separately in the P1/P2 plan. Anyone citing this test must
        cite it as pure-logic coverage only.

    Autodesk assemblies remain compile-time references (Private=false). accoremgd.dll is
    copied next to the test binary AT RUN TIME by tests/run-radius-policy-tests.sh, because
    the enum type is defined in that assembly and the CLR must resolve it to execute the
    policy. It is never committed and never packaged.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CadBridge.Tests.RadiusPromptPolicy</AssemblyName>
    <RootNamespace>CadBridge.Tests.PromptPolicy</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!--
      Deliberately NOT CadBridgePlugin=true: that switch injects the plugin reference set and
      the "never copy Autodesk assemblies" enforcement. This project is a test harness, not a
      plugin shell, so it declares the single reference it needs explicitly.
    -->
    <CadBridgePlugin>false</CadBridgePlugin>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the production policy source under test. No copy, no reimplementation. -->
    <Compile Include="..\..\src\Plugin.Shared\RadiusPromptPolicy.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(CadBridgeLegacyRefDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>
