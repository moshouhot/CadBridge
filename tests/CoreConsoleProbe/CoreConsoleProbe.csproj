<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Diagnostic probe (NOT product code). References only accoremgd + acdbmgd so it can be
    loaded by accoreconsole.exe, which does not provide acmgd.dll.

    Built for net48 because accoreconsole in the Legacy hosts runs on .NET Framework.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CadBridge.Diagnostics.CoreConsoleProbe</AssemblyName>
    <RootNamespace>CadBridge.Diagnostics.CoreConsoleProbe</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <CadBridgePlugin>true</CadBridgePlugin>
    <CadBridgeRefSet>core</CadBridgeRefSet>
  </PropertyGroup>

</Project>
